  }
  
  // Detect S* indicators
  if (hasSStarIndicators(text)) {
    return {
      state: "S*",
      sequence: "Weave ∘ Bind", // Maintain productivity
      lambda_eff: 0.36
    };
  }
  
  // Detect Void indicators
  if (hasVoidIndicators(text)) {
    return {
      state: "Void",
      sequence: "Telo ∘ Ortho ∘ Pro", // Emergency recovery
      lambda_eff: 0.35
